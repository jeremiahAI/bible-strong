const list = await (await fetch('http://localhost:9286/json')).json()
const t = list.find(x => x.url.includes('8ef07db')) 
const ws = new WebSocket(t.webSocketDebuggerUrl); await new Promise(r => (ws.onopen = r))
ws.onmessage = m => { const d = JSON.parse(m.data); if (d.id === 1) { console.log(String(d.result?.result?.value ?? JSON.stringify(d.result)).slice(0, 2500)); process.exit(0) } }
ws.send(JSON.stringify({ id: 1, method: 'Runtime.evaluate', params: { expression: process.argv[2], returnByValue: true, awaitPromise: true } }))
